# Copy this file to .env.local and fill in real values. Never commit .env.local.

# WhatsApp number check provider: walookup or 2chat
WA_CHECK_PROVIDER=walookup

# API key from the provider dashboard
#   WA Lookup: https://walookup.com  (Settings → API keys)
#   2Chat:     https://app.2chat.io  (Developers → API key)
WA_CHECK_API_KEY=

# 2Chat only: the church WhatsApp number you connected to 2Chat (E.164)
WA_CHECK_SENDER=
