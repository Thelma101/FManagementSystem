# Copy this file to .env.local and fill in real values. Never commit .env.local.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# ── Supabase (Project Settings → API keys) ────────────────────────────────────
# Browser-safe. VITE_* or NEXT_PUBLIC_* (as created by the Supabase ↔ Vercel integration) both work.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — never prefix these with VITE_ or NEXT_PUBLIC_
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Only needed locally for `npm run db:migrate` (Project Settings → Database)
SUPABASE_DB_PASSWORD=
# Optional: full connection string instead of auto-detecting the region
SUPABASE_DB_URL=

# ── SMS and WhatsApp sending: eBulkSMS (server-only) ──────────────────────────
# Needs the Supabase server settings above too: only signed-in portal members can send.
# Username is your eBulkSMS login email; API key is under API Settings on ebulksms.com.
# WhatsApp also needs the church number linked by QR code under WhatsApp on ebulksms.com.
EBULKSMS_USERNAME=
EBULKSMS_API_KEY=
# Sender name people see: up to 11 letters/numbers
EBULKSMS_SENDER=LivingFaith
# 1 = also reach MTN Do-Not-Disturb numbers (costs more per SMS), 0 = skip them
EBULKSMS_DND=1
